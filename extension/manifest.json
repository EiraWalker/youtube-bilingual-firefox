{
  "manifest_version": 2,
  "name": "YouTube 双语字幕 · Local",
  "version": "0.4.0",
  "description": "在 YouTube 播放器内显示原文与 OpenAI 兼容 API 翻译的字幕。",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-bilingual-local@local.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "permissions": ["storage", "downloads", "nativeMessaging", "https://www.youtube.com/*"],
  "optional_permissions": ["https://*/*", "http://*/*"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["player.css"],
      "run_at": "document_start"
    }
  ],
  "browser_action": { "default_title": "YouTube 双语字幕", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "48": "icon.svg", "96": "icon.svg" }
}
